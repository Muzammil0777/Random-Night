# DATABASE_URL / DATABASE_URL_UNPOOLED come from `neon env pull` into the repo-root .env.local (gitignored).
# Never commit real values. In production, set all of these in the Vercel dashboard.

# Direct URL of the Neon branch named "test" (get it with: neon connection-string test).
# Tests DROP ALL TABLES here on every run, so it must never be the production branch.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Admin panel (/admin). Password must be 12+ chars or nobody can log in.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Signs the admin session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Login emails (Resend). Without RESEND_API_KEY, links are only logged when APP_URL is localhost.
RESEND_API_KEY=
EMAIL_FROM=Random Night <login@yourdomain.in>
APP_URL=http://localhost:5173
