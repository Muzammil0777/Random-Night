# Copy to backend/.env (gitignored) and paste your Neon strings. Never commit .env.
# Neon dashboard -> Connect -> branch "main", pooling OFF (direct) for local use.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Same, but for a separate branch named "test". Tests DROP ALL TABLES here on every run.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
